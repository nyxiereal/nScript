{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/get.ps1"
    },
    {
      "source": "/f",
      "destination": "/get-force.ps1"
    },
    {
      "source": "/v",
      "destination": "/get-vbox.ps1"
    },
    {
      "source": "/c",
      "destination": "/get-cmd.ps1"
    },
    {
      "source": "/fc",
      "destination": "/get-force-cmd.ps1"
    },
    {
      "source": "/nScript.exe",
      "destination": "/nScript.exe"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/f",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/v",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/c",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/fc",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
